# Put ONE key here, then rename this file to .env
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the model name
LLM_MODEL=
PORT=3000

# Optional: BAND (https://app.band.ai). Create three remote agents (Agents > Connect remote agent)
# named Dana CFO, Raj CTO and Maya Sales Ops, and paste each agent's API key here.
BAND_CFO_KEY=
BAND_CTO_KEY=
BAND_USER_KEY=

# Optional: Telem (https://app.telem.ai). API keys > Issue API key, with the Telem Search service ticked.
TELEM_API_KEY=

# Optional: Glasser (https://app.glasser.ai/keys). Market and company data for Dana.
GLASSER_API_KEY=
